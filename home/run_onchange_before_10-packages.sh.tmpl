#!/bin/bash
# Installs system packages. Re-runs whenever a manifest changes:
# Brewfile: {{ include "../packages/Brewfile" | sha256sum | trunc 12 }}
# apt.txt: {{ include "../packages/apt.txt" | sha256sum | trunc 12 }}
# ubuntu-extras.sh: {{ include "../packages/ubuntu-extras.sh" | sha256sum | trunc 12 }}
# ubuntu-desktop.sh: {{ include "../packages/ubuntu-desktop.sh" | sha256sum | trunc 12 }}
set -euo pipefail
DOTS="{{ .chezmoi.sourceDir | dir }}"
ROLE="{{ .role }}"
echo "==> [10-packages] role=$ROLE"

{{ if eq .chezmoi.os "darwin" -}}
if ! command -v brew >/dev/null 2>&1; then
  echo "==> Installing Homebrew"
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
eval "$(/opt/homebrew/bin/brew shellenv)"
brew bundle --file="$DOTS/packages/Brewfile" --no-upgrade
{{ else if eq .chezmoi.os "linux" -}}
export DEBIAN_FRONTEND=noninteractive
# apt is the only step here that needs root, and two machines can't give it:
# an unprivileged LXC has no sudo at all, and a box whose sudo wants a password
# can't prompt when chezmoi runs over a non-interactive ssh. Skip rather than
# abort under set -e, so the dotfiles and user-level toolchains still land.
if [ "$(id -u)" -eq 0 ]; then SUDO=""
elif ! command -v sudo >/dev/null 2>&1; then SUDO=""; SKIP="no root and no sudo"
else
  [ -t 0 ] && sudo -v 2>/dev/null || true          # prompt once, only with a terminal
  if sudo -n true 2>/dev/null; then SUDO="sudo -n" # -n so a stale timestamp can never hang the run
  else SUDO=""; SKIP="sudo needs a password and there is no terminal; re-run as: ssh -t <host> 'chezmoi apply'"
  fi
fi
if [ -n "${SKIP:-}" ]; then
  echo "   $SKIP; skipping apt packages and extras"
else
  $SUDO apt-get update -q
  grep -vE '^\s*(#|$)' "$DOTS/packages/apt.txt" | xargs $SUDO apt-get install -y -q
  bash "$DOTS/packages/ubuntu-extras.sh"
{{ if not .wsl -}}
  if [ -d /run/systemd/system ]; then bash "$DOTS/packages/ubuntu-desktop.sh"; else echo "   no systemd (container?); skipping desktop apps"; fi
{{ end -}}
fi
{{ end -}}
echo "==> [10-packages] done"
