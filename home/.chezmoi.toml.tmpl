{{- /* Rendered once by `chezmoi init`; result lands in ~/.config/chezmoi/chezmoi.toml */ -}}
{{- $osrelease := index .chezmoi.kernel "osrelease" | default "" -}}
{{- $wsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower $osrelease)) -}}
{{- $role := "mac" -}}
{{- if $wsl }}{{ $role = "wsl" }}{{ else if eq .chezmoi.os "linux" }}{{ $role = "ubuntu" }}{{ end -}}
{{- /* CLONE_CODE=1 sh install.sh  (or edit cloneCode in ~/.config/chezmoi/chezmoi.toml later) */ -}}
{{- $cloneCode := ne (env "CLONE_CODE" | default "0") "0" -}}
{{- /* MINIMAL_TOOLCHAIN=1 on small-disk boxes; skips rust, bun, deno and rbenv */ -}}
{{- $minimalToolchain := ne (env "MINIMAL_TOOLCHAIN" | default "0") "0" -}}

sourceDir = {{ .chezmoi.sourceDir | dir | quote }}
encryption = "age"

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1r8adfpvf2wkktpuzv7r6ymcsx3h39ecj34hctxmvldft2x2ue9fspx42mm"

[data]
    role = {{ $role | quote }}
    wsl = {{ $wsl }}
    cloneCode = {{ $cloneCode }}
    # skips the ~1.5 GB rust toolchain and friends; for containers with a small rootfs
    minimalToolchain = {{ $minimalToolchain }}
    # gates both the ~/life clone and its bisync service; WSL reads on demand instead
    lifeSync = {{ not $wsl }}
